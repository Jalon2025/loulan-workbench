Fp9-sign.douyinpic.com\u002Ftos-cn-p-148450\u002FoQqtafraIQ29BU3HE1r3xAS6ABFcyCf7zgHDmE~tplv-noop.image?cquery=100X&dy_q=1792816600&l=20261024123639C66740DE77C2CE3D5B89&x-expires=1792820366&x-signature=LpCcT8Dz%2F5%2BKN0dgyAKauxk4dT8%3D\",\"key_seed\":\"T3qRgEyfNhCnQXWPwYwjMHWtFwo3JxSxlF\u002FZv7WeYlI=\"}","hasAudio":true,"isMute":false},"shortVideoData":{"downloadable":true}},{"id":"7695003820446911769","effectType":210,"commonAttr":{"id":"7695003820446911769","title":"致我们的世纪青春","description":"我们这一代人，像是出生在两个世界的交界处。 童年还留着乡土中国最后的余温：乡野、蝉鸣、雪花电视、街巷和没有网络的漫长的季节。 少年时代，互联网突然照进生活，我们在QQ、网吧、非主流和智能手机里长大。 如今青春的尾巴，又亲眼见证AI打开一个新的时代。 我们曾拥有最慢的童年，也正在奔向最快的未来。 从线下童年，到互联网少年，再到人工智能，一代人竟要穿过几个时代的风雨。 有时候会恍惚，我们的过去和现在，真的属于同一个世界吗？ 致90后，也致所有千禧年前后长大的你，——这场巨大的时代变迁，这场轰轰烈烈的世纪青春，本身就是属于我们这一代人，独一份的浪漫。","md5":"","status":102,"extra":"{\"eco_rate\":0,\"web_rate\":12,\"web_eco_rate\":0,\"ugc_content_value_llm\":{\"ugc_content_value_llm_type_id\":3,\"ugc_content_value_llm_type_name\":\"其他\"},\"sincere_sharing\":\"0\",\"item_community_kp\":\"{\\\"kp\\\":\\\"ai生成怀旧场景分享\\\",\\\"date\\\":\\\"2026-10-11 15:28:12.919\\\"}\",\"rate\":12}","file":{"fileUri":""},"effectId":"7695003820446911769","effectType":210,"coverUrl":"https:\u002F\u002Fp26-dreamina-sign.byteimg.com\u002Ftos-cn-i-tb4s082cfz\u002F7783099f73024e978dfc29229269ff31~tplv-tb4s082cfz-aigc_resize:200:200.png?lk3s=4fa96020&x-expires=1794960000&x-signature=Jr8ci5u7Ux9Yl0nlRlCsamvYXzY%3D","itemUrls":[""],"createTime":1791646469,"reviewInfo":{"reviewStatus":100,"reviewCodeList":[]},"aspectRatio":1.7857142857142858,"publishSource":"user_post_mweb_item","collectionIds":[],"hasPublished":true,"publishedItemId":"7695003820446911769","coverUrlMap":{"360":"https:\u002F\u002Fp26-dreamina-sign.byteimg.com\u002Ftos-cn-i-tb4s082cfz\u002F7783099f73024e978dfc29229269ff31~tplv-tb4s082cfz-aigc_resize:360:360.webp?lk3s=4fa96020&x-expires=1794960000&x-signature=8pmX0NF%2FPi8PiJ6%2Fl7fFxcz%2Bi5M%3D","480":"https:\u002F\u002Fp11-dreamina-sign.byteimg.com\u002Ftos-cn-i-tb4s0